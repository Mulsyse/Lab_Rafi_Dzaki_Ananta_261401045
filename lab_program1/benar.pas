program benar;

var
  nama, kelas: string;
  umur: integer;

begin
  write('Masukkan nama       : ');
  readln(nama);

  write('Masukkan umur       : ');
  readln(umur);

  write('Masukkan kelas      : ');
  readln(kelas);



  writeln;
  writeln('Nama       : ', nama);
  writeln('Umur       : ', umur);
  writeln('Kelas      : ', kelas);


  readln;
end.